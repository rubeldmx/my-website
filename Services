<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  body { margin: 0; padding: 0; }

  /* Color Palette & Base Setup */
  #rdmx-main-container {
    --ink: #0E1B2A; 
    --ink-soft: #16283F; 
    --paper: #F7F8F4;
    --growth: #1FA35C; 
    --growth-dark: #157A44; 
    --muted: #5B6B7A; 
    --line: rgba(14,27,42,0.10); 
    --white: #ffffff;
    font-family: 'Inter', sans-serif; 
    color: var(--ink); 
    background: var(--paper);
    width: 100%;
  }
  #rdmx-main-container * { box-sizing: border-box; }
  #rdmx-main-container h1, #rdmx-main-container h2, #rdmx-main-container h3, #rdmx-main-container h4 {
    font-family: 'Sora', sans-serif; 
    margin: 0;
  }
  #rdmx-main-container .wrap { max-width: 1000px; margin: 0 auto; }

  /* Services Section Styling */
  .services-section { padding: 48px 24px 60px; }
  .eyebrow { 
    font-family: 'IBM Plex Mono', monospace; 
    font-size: 12px; 
    letter-spacing: 0.12em; 
    text-transform: uppercase; 
    color: var(--growth-dark); 
    display: block; 
    margin-bottom: 10px;
  }
  .page-head { max-width: 700px; margin-bottom: 36px; }
  .page-head h1 { font-size: 32px; font-weight: 800; }
  .page-head p { color: var(--muted); margin-top: 10px; font-size: 15px; line-height: 1.7; }

  .svc-list { display: flex; flex-direction: column; gap: 20px; }
  .svc-item {
    background: var(--white); 
    border: 1px solid var(--line); 
    border-radius: 16px; 
    padding: 26px;
    display: grid; 
    grid-template-columns: 200px 1fr; 
    gap: 22px; 
    align-items: start;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .svc-item:hover {
    border-color: rgba(31, 163, 92, 0.3);
    box-shadow: 0 4px 20px rgba(14, 27, 42, 0.05);
  }
  .svc-tag { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--growth-dark); text-transform: uppercase; letter-spacing: .04em; }
  .svc-item h3 { font-size: 19px; font-weight: 700; margin-top: 8px; }
  .svc-item p { font-size: 14px; color: var(--muted); margin: 8px 0 0; line-height: 1.6; }
  .svc-item ul { margin: 12px 0 0; padding-left: 18px; }
  .svc-item li { font-size: 13.5px; color: var(--ink-soft); margin-bottom: 6px; line-height: 1.5; }

  /* Pill Tags for Tools & Operations */
  .tools-flex { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tool-pill {
    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 12.5px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 20px;
    color: var(--ink);
  }

  /* CTA Banner */
  .cta-banner { background: var(--growth); color: #fff; border-radius: 18px; padding: 36px 28px; text-align: center; margin-top: 40px; }
  .cta-banner h2 { font-size: 22px; margin-bottom: 8px; }
  .cta-banner p { color: rgba(255,255,255,0.9); margin-bottom: 18px; font-size: 14px; }
  .btn { display: inline-block; background: var(--ink); color: #fff; font-weight: 700; font-size: 14px; padding: 12px 24px; border-radius: 24px; text-decoration: none; transition: background 0.2s; }
  .btn:hover { background: var(--ink-soft); }

  /* Responsive Rules */
  @media (max-width:700px) {
    .svc-item { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div id="rdmx-main-container">

